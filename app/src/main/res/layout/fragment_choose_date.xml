<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1E3A">

    <!-- Header Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0D204A"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:backgroundTint="#33FFFFFF"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose date"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main Content Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Doctor Profile Mini Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivDoctor"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/doctor_profile"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="#0D204A"
                            app:strokeWidth="2dp" />

                        <TextView
                            android:id="@+id/tvRatingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rating"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/llStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="@id/tvRatingLabel"
                            app:layout_constraintStart_toEndOf="@id/tvRatingLabel"
                            app:layout_constraintTop_toTopOf="@id/tvRatingLabel">

                            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/ic_star" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="4.5"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            app:layout_constraintBottom_toBottomOf="@id/llStars"
                            app:layout_constraintStart_toEndOf="@id/llStars"
                            app:layout_constraintTop_toTopOf="@id/llStars" />

                        <TextView
                            android:id="@+id/tvDoctorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Dr. Wesly Jeyananthan Abisha"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivDoctor"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvRatingLabel" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dentist specialist"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDoctorName" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Date Selection Grid Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#0D204A"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="January 2026"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="horizontal">

                            <!-- Today -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnToday"
                                android:layout_width="0dp"
                                android:layout_height="80dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#0D204A"
                                app:cardCornerRadius="8dp"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today, 23" android:textColor="#FFFFFF" android:textSize="12sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feb" android:textColor="#FFFFFF" android:textSize="12sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Tomorrow -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnTomorrow"
                                android:layout_width="0dp"
                                android:layout_height="80dp"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#2211FF"
                                app:cardCornerRadius="8dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tomorrow," android:textColor="#FFFFFF" android:textSize="12sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24 Feb" android:textColor="#FFFFFF" android:textSize="12sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Thu, 25 -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnNext"
                                android:layout_width="0dp"
                                android:layout_height="80dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#0D204A"
                                app:cardCornerRadius="8dp"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="1dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu, 25" android:textColor="#FFFFFF" android:textSize="12sp" />
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feb" android:textColor="#FFFFFF" android:textSize="12sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Next Availability Message -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/rounded_dark_bg"
                    android:backgroundTint="#0D204A"
                    android:gravity="center"
                    android:text="Next availability on wed, 24 Feb"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <!-- OR Separator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <View android:layout_width="60dp" android:layout_height="1dp" android:background="#999999" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" OR " android:textColor="#000000" android:textStyle="bold" />
                    <View android:layout_width="60dp" android:layout_height="1dp" android:background="#999999" />
                </LinearLayout>

                <!-- Contact Clinic Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContactClinic"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#0D204A"
                    android:text="Contact Clinic"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="2dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
