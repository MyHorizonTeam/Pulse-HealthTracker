<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121995"
    tools:context=".Login">


    <TextView
        android:id="@+id/textView"
        android:layout_width="270dp"
        android:layout_height="25dp"
        android:text="Welcome to Pulse,"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.098"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.171" />


    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="370dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/scrv_gradiant"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.487"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|top"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/authToggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logswitch"
                    android:layout_width="140dp"
                    android:layout_height="56dp"
                    android:text="Login"
                    app:backgroundTint="#4B61F2"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/regswitch"
                    android:layout_width="140dp"
                    android:layout_height="56dp"
                    android:text="Register"
                    app:background="@drawable/btn_border"
                    app:backgroundTint="#0E164B"
                    app:cornerRadius="12dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
            <!--Login Layout-->
            <LinearLayout
                android:id="@+id/logLyt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center|top"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogleSignIn"
                    android:layout_width="350dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Continue With Google"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@null"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp" />

                <!-- OR Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  or continue with email  "
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/black" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtxtEmail"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edtxtlog"
                    android:ems="10"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"
                    android:padding="8dp"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/edtxtPwd"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:background="@drawable/edtxtlog"
                    android:ems="10"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnLog"
                    android:layout_width="wrap_content"
                    android:layout_height="41dp"
                    android:layout_margin="15dp"
                    android:background="@drawable/logbtn"
                    android:text="Log in"
                    app:backgroundTint="#0E164B" /> <!--ems means how long character can fit inside-->
                <TextView
                    android:id="@+id/frgpwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_font"
                    android:text="Forgotten password?"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!--Register Layout-->
            <LinearLayout
                android:id="@+id/regLyt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|top"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogleSignInR"
                    android:layout_width="350dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Continue With Google"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@null"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp" />

                <!-- OR Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  or continue with email  "
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/black" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtxtName"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/edtxtlog"
                    android:ems="10"
                    android:hint="Enter your name"
                    android:inputType="textPersonName"
                    android:padding="8dp"
                    android:textSize="20sp"
                    android:autofillHints="name" />

                <EditText
                    android:id="@+id/edtxtEmailR"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/edtxtlog"
                    android:ems="10"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"
                    android:padding="8dp"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/edtxtPwdR"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/edtxtlog"
                    android:ems="10"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/edtcnpwd"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/edtxtlog"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:textSize="20sp"
                    android:autofillHints="password" />

                <Button
                    android:id="@+id/btnReg"
                    android:layout_width="wrap_content"
                    android:layout_height="41dp"
                    android:layout_margin="15dp"
                    android:background="@drawable/logbtn"
                    android:text="Register"
                    app:backgroundTint="#0E164B" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.455"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.02"
        app:srcCompat="@mipmap/ic_launcher_foreground" />


</androidx.constraintlayout.widget.ConstraintLayout>