@@ -0,0 +1,101 @@
+package com.example.pulse_healthtracker
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.provider.Settings
+import android.util.Log
+import android.widget.Toast
+import java.text.SimpleDateFormat
+import java.util.*
+
+class ReminderManager(private val context: Context) {
+
+    fun scheduleReminder(pillName: String, timeStr: String, dateStr: String) {
+        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        
+        // Check if we can schedule exact alarms on Android 12+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            if (!alarmManager.canScheduleExactAlarms()) {
+                Log.w("ReminderManager", "Cannot schedule exact alarms. Redirecting to settings.")
+                val intent = Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM)
+                intent.flags = Intent.FLAG_ACTIVITY_NEW_TASK
+                context.startActivity(intent)
+                return
+            }
+        }
+
+        // Parse date and time
+        // Date: yyyy-MM-dd, Time: hh:mm a
+        val sdf = SimpleDateFormat("yyyy-MM-dd hh:mm a", Locale.getDefault())
+        val date = try {
+            sdf.parse("$dateStr $timeStr")
+        } catch (e: Exception) {
+            Log.e("ReminderManager", "Failed to parse date/time: $dateStr $timeStr")
+            null
+        } ?: return
+        
+        val calendar = Calendar.getInstance()
+        calendar.time = date
+
+        // If time has already passed, don't set
+        if (calendar.timeInMillis <= System.currentTimeMillis()) {
+            Log.d("ReminderManager", "Time already passed for $pillName at $timeStr")
+            return
+        }
+
+        val intent = Intent(context, ReminderReceiver::class.java).apply {
+            putExtra("pillName", pillName)
+            putExtra("time", timeStr)
+        }
+
+        // Use a unique requestCode based on pillName and time to allow multiple reminders
+        val requestCode = (pillName + timeStr).hashCode()
+
+        val pendingIntent = PendingIntent.getBroadcast(
+            context,
+            requestCode,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
+                val alarmClockInfo = AlarmManager.AlarmClockInfo(calendar.timeInMillis, pendingIntent)
+                alarmManager.setAlarmClock(alarmClockInfo, pendingIntent)
+            } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                alarmManager.setExactAndAllowWhileIdle(
+                    AlarmManager.RTC_WAKEUP,
+                    calendar.timeInMillis,
+                    pendingIntent
+                )
+            } else {
+                alarmManager.setExact(
+                    AlarmManager.RTC_WAKEUP,
+                    calendar.timeInMillis,
+                    pendingIntent
+                )
+            }
+            Log.d("ReminderManager", "Alarm set for $pillName at ${calendar.time}")
+        } catch (e: SecurityException) {
+            Log.e("ReminderManager", "SecurityException: ${e.message}")
+        } catch (e: Exception) {
+            Log.e("ReminderManager", "Error setting alarm: ${e.message}")
+        }
+    }
+    
+    fun cancelReminder(pillName: String, timeStr: String) {
+        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
+        val intent = Intent(context, ReminderReceiver::class.java)
+        val requestCode = (pillName + timeStr).hashCode()
+        val pendingIntent = PendingIntent.getBroadcast(
+            context,
+            requestCode,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        alarmManager.cancel(pendingIntent)
+    }
+}
