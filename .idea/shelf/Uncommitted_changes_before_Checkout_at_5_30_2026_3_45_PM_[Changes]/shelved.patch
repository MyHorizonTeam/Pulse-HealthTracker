@@ -0,0 +1,53 @@
+package com.example.pulse_healthtracker
+
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+import androidx.recyclerview.widget.RecyclerView
+import java.text.SimpleDateFormat
+import java.util.*
+
+class CalendarAdapter(
+    private var days: List<CalendarDate>,
+    private val onDateSelected: (CalendarDate) -> Unit
+) : RecyclerView.Adapter<CalendarAdapter.CalendarViewHolder>() {
+
+    class CalendarViewHolder(view: View) : RecyclerView.ViewHolder(view) {
+        val tvDayName: TextView = view.findViewById(R.id.tvDayName)
+        val tvDayNumber: TextView = view.findViewById(R.id.tvDayNumber)
+    }
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): CalendarViewHolder {
+        val view = LayoutInflater.from(parent.context).inflate(R.layout.item_calendar_day, parent, false)
+        return CalendarViewHolder(view)
+    }
+
+    override fun onBindViewHolder(holder: CalendarViewHolder, position: Int) {
+        val item = days[position]
+        val sdfDay = SimpleDateFormat("EEE", Locale.getDefault())
+        val sdfDate = SimpleDateFormat("dd", Locale.getDefault())
+
+        holder.tvDayName.text = sdfDay.format(item.date)
+        holder.tvDayNumber.text = sdfDate.format(item.date)
+
+        if (item.isSelected) {
+            holder.tvDayNumber.setBackgroundResource(R.drawable.bg_selected_date)
+            holder.tvDayNumber.setTextColor(0xFFFFFFFF.toInt())
+        } else {
+            holder.tvDayNumber.background = null
+            holder.tvDayNumber.setTextColor(0xFF555577.toInt())
+        }
+
+        holder.itemView.setOnClickListener {
+            onDateSelected(item)
+        }
+    }
+
+    override fun getItemCount() = days.size
+
+    fun updateData(newDays: List<CalendarDate>) {
+        days = newDays
+        notifyDataSetChanged()
+    }
+}
